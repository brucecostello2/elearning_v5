# =============================================================================
# IVGS v5 — Environment Variables: node-02 (vLLM Primary + CogVideoX)
# =============================================================================
# Spec reference: Appendix A.2, Table 2-2 (node-02)
# =============================================================================

# === Docker Image Tags ===
IVGS_API_TAG=CHANGE_ME_TO_SHA_DIGEST
IVGS_WORKERS_TAG=CHANGE_ME_TO_SHA_DIGEST

# === Node Identity ===
NODE_HOSTNAME=node-02
NODE_IP=10.10.0.2

# === Database & Redis (connect to node-01) ===
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
DATABASE_URL=postgresql+psycopg://ivgs:CHANGE_ME_STRONG_PASSWORD_32_CHARS@10.10.0.1:5432/ivgs
REDIS_URL=redis://10.10.0.1:6379/0

# === GPU Scheduler ===
GPU_SCHEDULER_URL=http://10.10.0.1:8002

# === SeaweedFS ===
SEAWEEDFS_FILER_URL=http://10.10.0.1:8888

# === vLLM Configuration (Table B-1: Llama 3.3 70B) ===
VLLM_MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct
VLLM_SERVED_NAME=llama-70b
VLLM_TP_SIZE=1
VLLM_MAX_MODEL_LEN=8192
VLLM_API_KEY=ivgs-internal

# === CogVideoX / Wan2.1 (Table B-1: 24 GB / 16 GB) ===
COGVIDEOX_MODEL=THUDM/CogVideoX-5b
WAN21_MODEL=Wan-AI/Wan2.1-T2V-14B

# === NFS Shared Volume ===
SHARED_VOLUME_PATH=/mnt/ivgs-shared

# === PROHIBITED ===
# OPENAI_API_KEY — NEVER
# ANTHROPIC_API_KEY — NEVER
# ELEVENLABS_API_KEY — NEVER
# DID_API_KEY — NEVER
