# =============================================================
# IVGS v4 Phase 4 Environment Variables
# Copy to .env and fill in values.
# NO AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — self-hosted only.
# =============================================================

# SeaweedFS cluster endpoints
SEAWEEDFS_MASTER_URL=http://node-01:9333
SEAWEEDFS_FILER_URL=http://node-01:8888
SEAWEEDFS_DEFAULT_REPLICATION=001

# Storage tier mount points (local filesystem)
SEAWEEDFS_HOT_MOUNT=/mnt/nvme/seaweedfs/volumes
SEAWEEDFS_WARM_MOUNT=/mnt/ssd/seaweedfs/volumes
SEAWEEDFS_COLD_MOUNT=/mnt/hdd/seaweedfs/volumes
SEAWEEDFS_ARCHIVE_MOUNT=/mnt/archive/seaweedfs/volumes

# NAS backup
NAS_BACKUP_PATH=/mnt/backup
NAS_HOST=10.10.0.7
NAS_SHARE=/volume1/ivgs-backup
BACKUP_RETENTION_DAYS=30

# Alerting (Alertmanager webhook or Slack URL)
ALERT_WEBHOOK_URL=http://node-01:9093/api/v1/alerts

# Database (inherited from base phases)
DATABASE_URL=postgresql://ivgs:${POSTGRES_PASSWORD}@node-01:5432/ivgs
POSTGRES_PASSWORD=change_me_in_production

# Redis (inherited)
REDIS_URL=redis://node-01:6379/0
REDIS_SCHEDULER_URL=redis://node-01:6379/1

# Retention defaults
DEFAULT_HOT_DAYS=7
DEFAULT_WARM_DAYS=30
DEFAULT_COLD_DAYS=180
DEFAULT_DELETE_AFTER_DAYS=365
