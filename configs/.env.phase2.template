# Phase 2 additional environment variables
# Copy to .env.phase2 and fill in actual values.
# Source alongside .env.phase1 before starting services.

# Monitoring
PROMETHEUS_URL=http://node-01:9090
GRAFANA_URL=http://node-01:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme

# DLQ Configuration
DLQ_ALERT_THRESHOLD=10       # Pending DLQ messages before alert fires
RABBITMQ_MGMT_URL=http://node-01:15672
RABBITMQ_USER=ivgs
RABBITMQ_PASS=changeme

# Quality Validation
QUALITY_MODEL_ENDPOINT=      # Optional: CLIP API endpoint (blank = heuristic fallback)
QUALITY_THRESHOLDS_PATH=/app/configs/quality_thresholds.yaml

# Celery Beat (Phase 2 periodic tasks)
CELERY_BEAT_SCHEDULER=redbeat.RedBeatScheduler
REDBEAT_REDIS_URL=redis://node-01:6379/1

# Segment Rendering
SEGMENT_DURATION_MS=30000    # Default segment duration (30 seconds)
MAX_SEGMENT_RETRIES=3
