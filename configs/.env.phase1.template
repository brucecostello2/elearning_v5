# IVGS Phase 1 — Environment Variables Template
# Copy: cp configs/.env.phase1.template configs/.env.phase1
# Fill all <CHANGE_ME> values before deployment

# ── Database ──────────────────────────────────────────────────────
POSTGRES_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql://ivgs:${POSTGRES_PASSWORD}@node-01:5432/ivgs

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://node-01:6379/0
REDIS_SCHEDULER_URL=redis://node-01:6379/1

# ── GPU Scheduler ─────────────────────────────────────────────────
GPU_SCHEDULER_URL=http://ivgs-scheduler:8001
VRAM_HEADROOM_PCT=0.10
COST_CEILING_USD=10.0

# ── Pipeline Resilience ───────────────────────────────────────────
CHECKPOINT_ENABLED=true
RETRY_MAX_DEFAULT=4
IDEMPOTENCY_TTL=86400
FALLBACK_ENABLED=true

# ── Image Registry ────────────────────────────────────────────────
IMAGE_TAG=v4.1.0
REGISTRY=ghcr.io/ivgs

# ── Monitoring ────────────────────────────────────────────────────
HEARTBEAT_INTERVAL=30
LOG_LEVEL=info
SENTRY_DSN=<CHANGE_ME_OR_LEAVE_EMPTY>

# ── Secrets ───────────────────────────────────────────────────────
SECRET_KEY=<CHANGE_ME_64_CHAR_HEX>
OPENAI_API_KEY=<CHANGE_ME>
REPLICATE_API_TOKEN=<CHANGE_ME>
