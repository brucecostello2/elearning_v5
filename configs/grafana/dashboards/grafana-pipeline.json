  },
  "description": "IVGS v5 Pipeline Overview — Job status, throughput, latency, queue depths, DLQ metrics (§13.2 Table 13-2)",
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [],
      "targetBlank": true,
      "title": "GPU Fleet Dashboard",
      "tooltip": "Navigate to GPU Fleet Utilization",
      "type": "link",
      "url": "/d/gpu-fleet/gpu-fleet-utilization"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Pipeline Job Status",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "Job success and failure rates over time (Table 13-2 Panel 1)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Jobs / min",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 15,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 80 }
            ]
          },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Failed" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Succeeded" },
            "properties": [
              { "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "maxHeight": 600, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "sum(rate(ivgs_pipeline_jobs_total{status=\"succeeded\"}[5m])) * 60",
          "legendFormat": "Succeeded",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "sum(rate(ivgs_pipeline_jobs_total{status=\"failed\"}[5m])) * 60",
          "legendFormat": "Failed",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Job Success / Fail Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "Average end-to-end pipeline duration (Table 13-2 Panel 2)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 300 },
              { "color": "red", "value": 600 }
            ]
          },
          "unit": "s",
          "min": 0,
          "max": 900
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 1 },
      "id": 2,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "avg(ivgs_pipeline_duration_seconds)",
          "legendFormat": "Avg Duration",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Avg Pipeline Duration",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "Active pipeline jobs currently being processed (Table 13-2 Panel 4)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "green", "value": 1 },
              { "color": "#EAB839", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": true,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "ivgs_pipeline_active_jobs",
          "legendFormat": "Active Jobs",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Active Jobs",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "DLQ unresolved message count (Table 13-2 Panel 7)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 5 },
              { "color": "red", "value": 10 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "background_solid",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": true,
        "textMode": "value_and_name",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "ivgs_dlq_message_count",
          "legendFormat": "DLQ Messages",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "DLQ Messages",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "Stage duration breakdown across all 7 pipeline stages (Table 13-2 Panel 3)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Duration (s)",
            "axisPlacement": "auto",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "lineWidth": 1,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "id": 5,
      "options": {
        "barRadius": 0.1,
        "barWidth": 0.7,
        "fullHighlight": false,
        "groupWidth": 0.7,
        "legend": { "calcs": ["mean"], "displayMode": "table", "placement": "right", "showLegend": true },
        "orientation": "horizontal",
        "showValue": "auto",
        "stacking": "none",
        "tooltip": { "maxHeight": 600, "mode": "multi", "sort": "desc" },
        "xTickLabelRotation": 0
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "avg by (stage) (ivgs_pipeline_stage_duration_seconds)",
          "legendFormat": "{{ stage }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Stage Duration Breakdown",
      "type": "barchart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "Queue depth per Celery queue (Table 13-2 Panel 5)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#EAB839", "value": 10 },
              { "color": "red", "value": 20 }
            ]
          },
          "unit": "none",
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 9 },
      "id": 6,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "vertical",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "ivgs_queue_depth{queue=~\".*\"}",
          "legendFormat": "{{ queue }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Queue Depths",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "Error distribution by category: transient, config, external, resource (Table 13-2 Panel 6)",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "hideFrom": { "legend": false, "tooltip": false, "viz": false } },
          "mappings": [],
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "transient" },
            "properties": [ { "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "config" },
            "properties": [ { "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "external" },
            "properties": [ { "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } } ]
          },
          {
            "matcher": { "id": "byName", "options": "resource" },
            "properties": [ { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } } ]
          }
        ]
      },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 9 },
      "id": 7,
      "options": {
        "displayLabels": ["name", "percent"],
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "tooltip": { "maxHeight": 600, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "sum by (error_category) (increase(ivgs_pipeline_errors_total[1h]))",
          "legendFormat": "{{ error_category }}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate by Category",
      "type": "piechart"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
      "description": "Hourly pipeline job throughput over time (Table 13-2 Panel 8)",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "blue", "mode": "fixed" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Jobs / hour",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 25,
            "gradientMode": "opacity",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 17 },
      "id": 8,
      "options": {
        "legend": { "calcs": ["mean", "max", "lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "maxHeight": 600, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus-ivgs" },
          "editorMode": "code",
          "expr": "sum(increase(ivgs_pipeline_jobs_total[1h]))",
          "legendFormat": "Total Jobs / Hour",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Hourly Throughput",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
