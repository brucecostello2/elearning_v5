{
  "__requires": [{"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0"}],
  "title": "IVGS Pipeline Overview",
  "uid": "ivgs-pipeline-overview",
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Job Success Rate (15m)",
      "gridPos": {"x":0,"y":0,"w":4,"h":4},
      "targets": [{"expr": "rate(ivgs_jobs_completed_total[15m]) / (rate(ivgs_jobs_completed_total[15m]) + rate(ivgs_jobs_failed_total[15m])) * 100", "legendFormat": "Success %"}],
      "fieldConfig": {"defaults": {"unit":"percent","thresholds": {"steps":[{"color":"red","value":0},{"color":"yellow","value":90},{"color":"green","value":95}]}}}
    },
    {
      "id": 2, "type": "stat", "title": "Active Jobs",
      "gridPos": {"x":4,"y":0,"w":4,"h":4},
      "targets": [{"expr": "ivgs_jobs_active_count", "legendFormat": "Active"}]
    },
    {
      "id": 3, "type": "timeseries", "title": "Job Throughput",
      "gridPos": {"x":0,"y":4,"w":12,"h":8},
      "targets": [
        {"expr": "rate(ivgs_jobs_completed_total[5m])", "legendFormat": "Completed/s"},
        {"expr": "rate(ivgs_jobs_failed_total[5m])", "legendFormat": "Failed/s"}
      ]
    },
    {
      "id": 4, "type": "timeseries", "title": "Stage Duration (p95)",
      "gridPos": {"x":12,"y":0,"w":12,"h":8},
      "targets": [
        {"expr": "histogram_quantile(0.95, rate(ivgs_stage_duration_seconds_bucket[5m]))", "legendFormat": "{{stage}}"}
      ]
    },
    {
      "id": 5, "type": "bargauge", "title": "DLQ Failures by Category",
      "gridPos": {"x":0,"y":12,"w":8,"h":6},
      "targets": [{"expr": "ivgs_dlq_failures_total", "legendFormat": "{{category}}"}]
    },
    {
      "id": 6, "type": "stat", "title": "DLQ Pending",
      "gridPos": {"x":8,"y":12,"w":4,"h":6},
      "targets": [{"expr": "ivgs_dlq_pending_count", "legendFormat": "Pending"}],
      "fieldConfig": {"defaults": {"thresholds":{"steps":[{"color":"green","value":0},{"color":"yellow","value":5},{"color":"red","value":10}]}}}
    },
    {
      "id": 7, "type": "timeseries", "title": "Queue Depths",
      "gridPos": {"x":12,"y":8,"w":12,"h":8},
      "targets": [{"expr": "rabbitmq_queue_messages", "legendFormat": "{{queue}}"}]
    }
  ]
}
