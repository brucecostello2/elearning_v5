# =============================================================================
# IVGS v4 — Complete Environment Variables
# =============================================================================
# Copy this file: cp .env.example .env
# Fill all <CHANGE_ME> values before deployment.
# Phase-specific templates are in configs/.env.phase*.template
# =============================================================================

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<CHANGE_ME>
DATABASE_URL=postgresql://ivgs:${POSTGRES_PASSWORD}@node-01:5432/ivgs

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://node-01:6379/0
REDIS_SCHEDULER_URL=redis://node-01:6379/1

# ── GPU Scheduler ────────────────────────────────────────────────────────────
GPU_SCHEDULER_URL=http://ivgs-scheduler:8001
VRAM_HEADROOM_PCT=0.10
COST_CEILING_USD=10.0

# ── Pipeline Resilience (Phase 1) ───────────────────────────────────────────
CHECKPOINT_ENABLED=true
RETRY_MAX_DEFAULT=4
IDEMPOTENCY_TTL=86400
FALLBACK_ENABLED=true

# ── Image Registry ───────────────────────────────────────────────────────────
IMAGE_TAG=v4.1.0
REGISTRY=ghcr.io/ivgs

# ── Monitoring (Phase 1+2) ──────────────────────────────────────────────────
HEARTBEAT_INTERVAL=30
LOG_LEVEL=info
SENTRY_DSN=<CHANGE_ME_OR_LEAVE_EMPTY>
PROMETHEUS_URL=http://node-01:9090
GRAFANA_URL=http://node-01:3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=<CHANGE_ME>

# ── Secrets ──────────────────────────────────────────────────────────────────
SECRET_KEY=<CHANGE_ME_64_CHAR_HEX>
OPENAI_API_KEY=<CHANGE_ME>
REPLICATE_API_TOKEN=<CHANGE_ME>

# ── DLQ Configuration (Phase 2) ─────────────────────────────────────────────
DLQ_ALERT_THRESHOLD=10
RABBITMQ_MGMT_URL=http://node-01:15672
RABBITMQ_USER=ivgs
RABBITMQ_PASS=<CHANGE_ME>

# ── Quality Validation (Phase 2) ────────────────────────────────────────────
QUALITY_MODEL_ENDPOINT=
QUALITY_THRESHOLDS_PATH=/app/configs/quality_thresholds.yaml

# ── Celery Beat ──────────────────────────────────────────────────────────────
CELERY_BEAT_SCHEDULER=redbeat.RedBeatScheduler
REDBEAT_REDIS_URL=redis://node-01:6379/1

# ── AI Video Models (Phase 3) ───────────────────────────────────────────────
COGVIDEOX_MODEL_PATH=/opt/models/cogvideox
WAN21_MODEL_PATH=/opt/models/wan2.1
AI_VIDEO_MODELS_CONFIG=/app/configs/ai_video_models.yaml
AI_VIDEO_MAX_CONCURRENT=2
AI_VIDEO_TIMEOUT=600

# ── Localization (Phase 3) ──────────────────────────────────────────────────
WHISPER_MODEL=large-v3
TTS_DEFAULT_VOICE=en-US-Neural2-F
SUPPORTED_LOCALES=en,es,fr,de,ja,zh,ko,pt,ar,hi
LOCALIZATION_CONFIG=/app/configs/localization.yaml

# ── Remotion (Phase 3) ──────────────────────────────────────────────────────
REMOTION_CONCURRENCY=2
REMOTION_TEMPLATE_DIR=/app/infra/remotion/templates

# ── SeaweedFS (Phase 4) ─────────────────────────────────────────────────────
SEAWEEDFS_MASTER=node-01:9333
SEAWEEDFS_FILER=node-01:8888
SEAWEEDFS_HOT_COLLECTION=hot
SEAWEEDFS_WARM_COLLECTION=warm
SEAWEEDFS_COLD_COLLECTION=cold

# ── Storage / Retention (Phase 4) ───────────────────────────────────────────
RETENTION_HOT_DAYS=14
RETENTION_WARM_DAYS=90
RETENTION_COLD_DAYS=365
RETENTION_DELETE_AFTER_DAYS=730

# ── Backup (Phase 4) ────────────────────────────────────────────────────────
BACKUP_NAS_PATH=/mnt/backup/ivgs
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ── Quotas (Phase 4) ────────────────────────────────────────────────────────
DEFAULT_PROJECT_QUOTA_GB=100
QUOTA_WARNING_PCT=80
QUOTA_HARD_LIMIT_PCT=95
