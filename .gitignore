# ============================================================
# IVGS v5 .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.staging
!.env.template

# Node.js / Frontend
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db
*.tmp
*.bak

# SSL certificates (NEVER commit)
configs/nginx/ssl/*.pem
configs/nginx/ssl/*.key
configs/nginx/ssl/*.crt
configs/nginx/ssl/*.csr

# Database
*.db
*.sqlite3

# Logs
*.log
logs/

# Model files (too large for git)
*.safetensors
*.bin
*.onnx
*.pt
*.pth
# ML model weight files (not ORM models in app/models/)
/models/
!**/app/models/

# Backup files
*.bak
*.bak-*
*.backup

# GPU/CUDA
*.cu.o

# Compiled
*.so
*.dylib
ivgs-frontend/tsconfig.tsbuildinfo
.logs/
.next/
ivgs-frontend/.next/

# Runtime data directories (never track, never clean)
rollback-storage/
ivgs-infra/configs/grafana/

# Coverage artifacts (generated by pytest --cov)
coverage.json
htmlcov/
.coverage

# node env files hold real secrets -- commit only the .example variants
.env.node0[1-6]

# node-local env files (secrets) - never commit
.env.node0*
ivgs-infra/.env.node0*

# local per-node model smoke-test compose files (not for the repo)
ivgs-infra/docker-compose.smoke-*.yml
ivgs-infra/.env.node01

# WP-46: the MBCP weight-fetch credentials (serving token + HMAC signing key).
# Delivered by the operator 2026-08-25 at mode 600. `git status` listed it as
# untracked, i.e. one `git add -A` away from the history. Never commit it.
.mbcp-weights.env
ivgs-infra/.mbcp-weights.env

# Pipeline evidence artifacts at the repository ROOT only (WP-TREE-TRIAGE 2026-08-22).
# draft_pillar2_f78eb063.mp4, final_1080p_9007b2cf.mp4 and presenter.mp4 are the
# cited evidence for ledger P1.4 and the 2026-08-14 status doc. Kept on disk, never
# tracked -- 38 MB of binary that a stray `git add .` would put in history for good.
# Root-anchored so fixtures and test media elsewhere in the tree are unaffected.
/*.mp4

# WP-35: tsc output for `npm run test:logic` (node --test against the compiled helper)
ivgs-frontend/.test-build/
