# ============================================================
# IVGS v5 .gitignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.project
.classpath

# Environment files (NEVER commit secrets)
.env
.env.local
.env.production
.env.staging
!.env.template

# Node.js / Frontend
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
.tox/

# Docker
docker-compose.override.yml

# OS
.DS_Store
Thumbs.db
*.tmp
*.bak

# SSL certificates (NEVER commit)
configs/nginx/ssl/*.pem
configs/nginx/ssl/*.key
configs/nginx/ssl/*.crt
configs/nginx/ssl/*.csr

# Database
*.db
*.sqlite3

# Logs
*.log
logs/

# Model files (too large for git)
*.safetensors
*.bin
*.onnx
*.pt
*.pth
# ML model weight files (not ORM models in app/models/)
/models/
!**/app/models/

# Backup files
*.bak
*.backup

# GPU/CUDA
*.cu.o

# Compiled
*.so
*.dylib
ivgs-frontend/tsconfig.tsbuildinfo
.logs/
.next/
ivgs-frontend/.next/

# Runtime data directories (never track, never clean)
rollback-storage/
ivgs-infra/configs/grafana/
