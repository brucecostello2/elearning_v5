# ============================================================
# IVGS v5 Environment Variables — Appendix A.2 compliant
# Copy to .env and fill in secrets before deployment
# ============================================================
#
# SECURITY NOTICE:
# - All values marked CHANGE_ME_* MUST be replaced before deployment
# - Generate JWT_SECRET_KEY with: python3 -c "import secrets; print(secrets.token_hex(64))"
# - Generate DATABASE password with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# - NEVER commit .env files to version control (they are .gitignored)
# - See docs/deployment/runbook.md for full security checklist
#

# === Database (PostgreSQL 17) ===
DATABASE_URL=postgresql+asyncpg://ivgs:CHANGE_ME_DB_PASSWORD@postgres:5432/ivgs
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# === Redis 7 ===
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

# === SeaweedFS ===
SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888
SEAWEEDFS_MOUNT_PATH=/ivgs

# === Service Ports (§3.1) ===
# FastAPI API: 8001, Next.js Frontend: 3001, GPU Scheduler: 8002
UVICORN_PORT=8001
FRONTEND_PORT=3001
FRONTEND_HOST=localhost

# === GPU Scheduler ===
GPU_SCHEDULER_URL=http://ivgs-scheduler:8001

# === Retention (§10.3) ===
RETENTION_JOB_CRON=0 2 * * *

# === Network topology — the single source of truth for node IPs ===
# Every node IP is declared once, here. Everything else (the node01.yml anchor, all
# service URLs, the node02-06 stacks) references ${NODE_xx_IP}. Renumber by editing the
# address(es) below, then redeploy to recreate. Any scheme works — consecutive or not,
# one subnet or split across subnets.
NODE_01_IP=192.168.1.90
NODE_02_IP=192.168.1.91
NODE_03_IP=192.168.1.92
NODE_04_IP=192.168.1.93
NODE_05_IP=192.168.1.94
NODE_06_IP=192.168.1.95

# === Remote service ports (composed into URLs by the node01.yml anchor) ===
VLLM_PORT=8000
OLLAMA_PORT=11434
COMFYUI_PORT=8188
COQUI_TTS_PORT=5002
KOKORO_TTS_PORT=5003
LATENTSYNC_PORT=7860
SADTALKER_PORT=7861
WHISPERX_PORT=9000
REMOTION_PORT=3002

# === GPU / remote-node service URLs ===
# Composed in docker-compose.node01.yml (x-gpu-service-urls anchor) from the
# NODE_xx_IP / *_PORT above. Do not hardcode them here.

# === Authentication (§16.1) ===
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET_64_CHARS_MINIMUM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Backup (§14.1) ===
BACKUP_NAS_PATH=/mnt/backup/ivgs
BACKUP_GPG_KEY_ID=CHANGE_ME_GPG_KEY_ID

# === NFS Shared Volume ===
SHARED_VOLUME_PATH=/mnt/ivgs-shared

# === Logging (§13.4) ===
LOG_LEVEL=INFO
LOG_FORMAT=json
NODE_HOSTNAME=node-01

# === PROHIBITED — these MUST NOT appear in .env (v5 mandate §7.2) ===
# OPENAI_API_KEY — NEVER
# ANTHROPIC_API_KEY — NEVER
# ELEVENLABS_API_KEY — NEVER
# DID_API_KEY — NEVER
