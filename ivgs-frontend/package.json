{
  "name": "ivgs-frontend",
  "version": "5.0.0",
  "private": true,
  "description": "IVGS v5 Dashboard — Next.js 14 unified content creation and operational monitoring",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx,css}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,css}'",
    "test:logic": "tsc src/lib/unwrap.ts src/lib/media.ts src/lib/text.ts src/lib/jobs.ts src/lib/errors.ts src/lib/scenes.ts src/lib/languages.ts src/lib/pipeline-run.ts src/lib/project-tabs.ts src/lib/project-state.ts --outDir .test-build --module es2022 --target es2022 --moduleResolution bundler --skipLibCheck && node --test src/lib/__tests__/*.test.mjs"
  },
  "dependencies": {
    "chart.js": "4.4.4",
    "clsx": "2.1.1",
    "date-fns": "3.6.0",
    "lucide-react": "0.441.0",
    "next": "14.2.15",
    "react": "18.3.1",
    "react-beautiful-dnd": "13.1.1",
    "react-chartjs-2": "5.2.0",
    "react-dom": "18.3.1",
    "swr": "2.2.5",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "20.16.10",
    "@types/react": "18.3.11",
    "@types/react-beautiful-dnd": "13.1.8",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "10.4.0",
    "eslint-config-next": "14.2.15",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.8",
    "tailwindcss": "3.4.13",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
