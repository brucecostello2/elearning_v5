# =============================================================================
# IVGS v5 — Environment Variables: node-05 (Image Fallback, Utility)
# =============================================================================
# Spec reference: Appendix A.2, Table 2-2 (node-05)
# =============================================================================

# === Docker Image Tags ===
IVGS_API_TAG=CHANGE_ME_TO_SHA_DIGEST
IVGS_WORKERS_TAG=CHANGE_ME_TO_SHA_DIGEST

# === Node Identity ===
NODE_HOSTNAME=node-05

# === node-01 (orchestrator) address — the only peer this node talks to ===
# Set to node-01's actual IP (whatever your router/admin assigned it). The compose
# file composes this node's Postgres / Redis / scheduler / SeaweedFS callback URLs
# from this single value, so they are not hardcoded here.
NODE_01_IP=192.168.1.90

# === Database password (compose composes DATABASE_URL from this + NODE_01_IP) ===
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# === ComfyUI Fallback (Table B-1: SDXL 1.0 = 10 GB) ===
COMFYUI_DEFAULT_MODEL=sdxl

# === Ollama (Table B-1: Llama 3.2 8B Q4 = 5 GB) ===
OLLAMA_DEFAULT_MODEL=llama3.2:8b-instruct-q4_0

# === FFmpeg Configuration ===
FFMPEG_HWACCEL=cuda
FFMPEG_THREADS=4

# === NFS Shared Volume ===
SHARED_VOLUME_PATH=/mnt/ivgs-shared

# === PROHIBITED ===
# OPENAI_API_KEY — NEVER
# ANTHROPIC_API_KEY — NEVER
# ELEVENLABS_API_KEY — NEVER
# DID_API_KEY — NEVER
