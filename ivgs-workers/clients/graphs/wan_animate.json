{
  "1": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "{served_model_name}",
      "base_precision": "fp16_fast",
      "quantization": "disabled",
      "load_device": "main_device",
      "attention_mode": "sdpa"
    }
  },
  "2": {
    "class_type": "WanVideoVAELoader",
    "inputs": {
      "model_name": "Wan2_1_VAE_bf16.safetensors",
      "precision": "bf16"
    }
  },
  "3": {
    "class_type": "WanVideoLoraSelectMulti",
    "inputs": {
      "lora_0": "WanAnimate_relight_lora_fp16.safetensors",
      "strength_0": 1.0,
      "lora_1": "lightx2v_I2V_14B_480p_cfg_step_distill_rank64_bf16.safetensors",
      "strength_1": 1.0,
      "lora_2": "none",
      "strength_2": 1.0,
      "lora_3": "none",
      "strength_3": 1.0,
      "lora_4": "none",
      "strength_4": 1.0,
      "merge_loras": false,
      "low_mem_load": false
    }
  },
  "4": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "clip_vision_h.safetensors"
    }
  },
  "5": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "{ref_image_file}"
    }
  },
  "6": {
    "class_type": "ImageScale",
    "inputs": {
      "image": [
        "5",
        0
      ],
      "upscale_method": "lanczos",
      "width": "{output_width}",
      "height": "{output_height}",
      "crop": "disabled"
    }
  },
  "7": {
    "class_type": "VHS_LoadVideo",
    "inputs": {
      "video": "{driving_video_file}",
      "force_rate": 0,
      "custom_width": "{output_width}",
      "custom_height": "{output_height}",
      "frame_load_cap": "{num_frames}",
      "skip_first_frames": 0,
      "select_every_nth": 1
    }
  },
  "8": {
    "class_type": "OnnxDetectionModelLoader",
    "inputs": {
      "vitpose_model": "vitpose-l-wholebody.onnx",
      "yolo_model": "yolov10m.onnx",
      "onnx_device": "CUDAExecutionProvider"
    }
  },
  "9": {
    "class_type": "PoseAndFaceDetection",
    "inputs": {
      "model": [
        "8",
        0
      ],
      "images": [
        "7",
        0
      ],
      "width": "{output_width}",
      "height": "{output_height}",
      "face_padding": 0
    }
  },
  "10": {
    "class_type": "DrawViTPose",
    "inputs": {
      "pose_data": [
        "9",
        0
      ],
      "width": "{output_width}",
      "height": "{output_height}",
      "retarget_padding": 16,
      "body_stick_width": -1,
      "hand_stick_width": -1,
      "draw_head": true
    }
  },
  "11": {
    "class_type": "WanVideoClipVisionEncode",
    "inputs": {
      "clip_vision": [
        "4",
        0
      ],
      "image_1": [
        "6",
        0
      ],
      "strength_1": 1.0,
      "strength_2": 1.0,
      "crop": "center",
      "combine_embeds": "average",
      "force_offload": true
    }
  },
  "12": {
    "class_type": "WanVideoAnimateEmbeds",
    "inputs": {
      "vae": [
        "2",
        0
      ],
      "width": "{output_width}",
      "height": "{output_height}",
      "num_frames": "{num_frames}",
      "force_offload": true,
      "frame_window_size": "{frame_window_size}",
      "colormatch": "disabled",
      "pose_strength": "{pose_strength}",
      "face_strength": "{face_strength}",
      "clip_embeds": [
        "11",
        0
      ],
      "ref_images": [
        "6",
        0
      ],
      "pose_images": [
        "10",
        0
      ],
      "face_images": [
        "9",
        1
      ]
    }
  },
  "13": {
    "class_type": "WanVideoSetLoRAs",
    "inputs": {
      "model": [
        "1",
        0
      ],
      "lora": [
        "3",
        0
      ]
    }
  },
  "14": {
    "class_type": "WanVideoTextEncodeCached",
    "inputs": {
      "model_name": "umt5-xxl-enc-bf16.safetensors",
      "precision": "bf16",
      "positive_prompt": "{prompt}",
      "negative_prompt": "{negative_prompt}",
      "quantization": "disabled",
      "use_disk_cache": false,
      "device": "gpu"
    }
  },
  "15": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": [
        "13",
        0
      ],
      "image_embeds": [
        "12",
        0
      ],
      "steps": "{steps}",
      "cfg": "{cfg}",
      "shift": "{shift}",
      "seed": "{seed}",
      "force_offload": true,
      "scheduler": "{scheduler}",
      "riflex_freq_index": 0,
      "text_embeds": [
        "14",
        0
      ]
    }
  },
  "16": {
    "class_type": "WanVideoDecode",
    "inputs": {
      "vae": [
        "2",
        0
      ],
      "samples": [
        "15",
        0
      ],
      "enable_vae_tiling": true,
      "tile_x": 272,
      "tile_y": 272,
      "tile_stride_x": 144,
      "tile_stride_y": 128
    }
  },
  "17": {
    "class_type": "VHS_VideoCombine",
    "inputs": {
      "images": [
        "16",
        0
      ],
      "frame_rate": "{output_fps}",
      "loop_count": 0,
      "filename_prefix": "mbcp_wan_animate",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": false,
      "pingpong": false,
      "save_output": true
    }
  }
}