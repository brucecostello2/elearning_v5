# =============================================================================
# IVGS v5 — Environment Variables: node-04 (Image, TTS, Talking Head)
# =============================================================================
# Spec reference: Appendix A.2, Table 2-2 (node-04)
# =============================================================================

# === Docker Image Tags ===
IVGS_API_TAG=CHANGE_ME_TO_SHA_DIGEST
IVGS_WORKERS_TAG=CHANGE_ME_TO_SHA_DIGEST

# === Node Identity ===
NODE_HOSTNAME=node-04

# === node-01 (orchestrator) address — the only peer this node talks to ===
# Set to node-01's actual IP (whatever your router/admin assigned it). The compose
# file composes this node's Postgres / Redis / scheduler / SeaweedFS callback URLs
# from this single value, so they are not hardcoded here.
NODE_01_IP=192.168.1.90

# === Database password (compose composes DATABASE_URL from this + NODE_01_IP) ===
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS

# === vLLM Mid-Size (Table B-1: Mistral 24B = 48 GB) ===
VLLM_MODEL_NAME=mistralai/Mistral-Small-24B-Instruct-2501
VLLM_SERVED_NAME=mistral-24b
VLLM_MAX_MODEL_LEN=8192
VLLM_API_KEY=ivgs-internal

# === ComfyUI (Table B-1: FLUX.1 Dev = 24 GB, AnimateDiff = 16 GB) ===
COMFYUI_DEFAULT_MODEL=flux-dev

# === Coqui XTTS v2 (Table B-1: 16 GB, §17.1: 8 languages) ===
COQUI_TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2

# === Kokoro TTS (Table B-1: 4 GB — English-only fallback) ===
KOKORO_TTS_MODEL=kokoro-en-v0.19

# === WhisperX (Table B-1: 8 GB — large-v3) ===
WHISPERX_MODEL=large-v3

# === LatentSync (Table B-1: 12 GB — primary lip-sync) ===
LATENTSYNC_MODEL=latentsync-v1

# === SadTalker (Table B-1: 8 GB — fallback lip-sync) ===
SADTALKER_MODEL=sadtalker-v2

# === NFS Shared Volume ===
SHARED_VOLUME_PATH=/mnt/ivgs-shared

# === PROHIBITED ===
# OPENAI_API_KEY — NEVER
# ANTHROPIC_API_KEY — NEVER
# ELEVENLABS_API_KEY — NEVER
# DID_API_KEY — NEVER
