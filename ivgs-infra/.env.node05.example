# =============================================================================
# IVGS v5 - Environment Variables: node-05 (Qwen LLM node)
# =============================================================================
# WP-61-QWEN. node-05's role is the Qwen LLM node, per the operator ruling of
# 2026-08-26 and the standalone evaluation of 2026-08-25. This SUPERSEDES the
# AD-02 Draft-4 quality-services assignment (the CLIP scorer now runs on
# node-06 and node-06 is its sole host - verified served_by node-06). See
# docs/IVGS_v5_Addendum_AD-02_Draft4_node05_quality_services_DRAFT.md section 7.
#
# WRITTEN FROM SCRATCH, NOT COPIED FROM .env.node02.example. That template is
# known stale: it carries CHANGE_ME image-tag placeholders for images this node
# does not run, a POSTGRES_PASSWORD this node has no use for (node-05 runs no
# Celery worker and opens no database connection), and a CogVideoX/Wan2.1 block
# for engines it does not host. Copying it would have put four wrong facts on
# the node in the name of consistency.
#
# HOW TO USE. Copy to `.env.node05` ON NODE-05 and fill in nothing: every value
# below is correct as shipped. `.env.node05` is gitignored
# (.gitignore:118, `ivgs-infra/.env.node0*`); this `.example` is the tracked
# statement of what it must contain.
#
#   chmod 600 .env.node05
#
# WHAT NODE-05 IS NOT. It is not a Celery consumer, it subscribes to no queue,
# and it must not be added to the GPU scheduler's fleet - vLLM nodes are not
# Celery workers, and AD-02's `dynamically_loadable=false` stands: this node's
# LLM capability is fixed at container start by the `--model` argument and
# cannot be swapped at runtime.
# =============================================================================

# === Node Identity (WP-45 Task 4(a) identity block) ==========================
# The GPU scheduler keys nodes as {node_hostname}:gpu{index}, and node_hostname
# defaults to the CONTAINER hostname - a hex id that changes on every recreate.
# Measured 2026-08-25: 21 registered "nodes" on a fleet of three GPUs, none of
# which could be traced to a physical machine. IVGS_NODE_NAME is the stable
# name; ivgs-workers/config.py:315 reads it BEFORE IVGS_NODE_HOSTNAME.
#
# node-05 registers with nothing today - it runs no worker. The block is here
# anyway and it is not decoration: the telemetry pair, the node-logs sidecar
# and any future service on this box read the same three variables, and a node
# whose identity is declared in one place cannot half-answer.
IVGS_NODE_NAME=node-05
IVGS_NODE_HOSTNAME=node-05
IVGS_NODE_ID=node-05
NODE_HOSTNAME=node-05

# === node-01 (orchestrator) address ==========================================
# node-05 initiates nothing toward node-01 today. Recorded so a future service
# on this box composes its URLs from one value rather than hardcoding an IP.
NODE_01_IP=192.168.1.90

# === vLLM: the Qwen invocation, as MEASURED 2026-08-25 =======================
# Every value below was established by failure during the standalone
# evaluation. Read /mnt/ivgs-shared/qwen-invocation.txt before changing one.

# === THE ENGINE IMAGE IS PINNED BY DIGEST (WP-62 Task 8(d)) ==================
#
# WHY. `cu130-nightly` is a floating tag and it MOVED during WP-61: the
# operator pulled it twice and got two different images REPORTING THE SAME
# vLLM VERSION STRING, v0.19.2rc1.dev134. The one field a reader would have
# checked to notice a change did not change. The second pull is
# sha256:3dbe092e..., and that is the image every REAL-48GB figure in the
# WP-61 report was measured on: KV 11.43 GiB / 46,256 tokens, 1.39x at 131K,
# 42.7 GB idle, storyboard 9.2 s, the 60,324-token probe.
#
# The compose file now references `vllm/vllm-openai@${VLLM_IMAGE_DIGEST}` with
# NO `:-` default, so an unset value makes compose refuse to render rather than
# quietly starting whatever `cu130-nightly` points at today.
#
# HOW TO FILL IT IN. The value below is the RECORDED PREFIX ONLY - eight hex
# characters is what this package was given, and inventing the other 56 would
# be worse than leaving it visibly incomplete. Operator block A06B reads the
# full digest off the running container on node-05 and writes it into
# `.env.node05`, refusing if it does not start with the prefix below. Do not
# hand-type it.
#
#     node-05:  docker inspect ivgs-vllm-qwen-node05 \
#                 --format '{{index .RepoDigests 0}}'
#
# THIS LINE IS DELIBERATELY NOT A VALID DIGEST. A file that ships a plausible
# but wrong 64-character string is how a fleet gets pinned to an image nobody
# ran.
VLLM_IMAGE_DIGEST=sha256:3dbe092ec5b2cef63b6104d33fa75d6ce53a7870962529ada69f78bbbc38e776
#
# The tag the digest above was pulled FROM. Documentation only - nothing
# interpolates it any more, and re-pulling it is not a way to get this image.
VLLM_IMAGE_TAG=cu130-nightly

VLLM_MODEL_NAME=Qwen/Qwen3.8-27B-FP8
VLLM_SERVED_NAME=qwen38-27b
VLLM_PORT=8000

# 131072 configured, PROVEN at a 60,069-token prompt.
VLLM_MAX_MODEL_LEN=131072

# MANDATORY. Qwen3.8 is hybrid attention/Mamba: each decode sequence consumes
# one Mamba cache block, 216 were available at the 48 GB budget, and vLLM's
# default of 1024 makes the engine REFUSE TO START. If the real card reports
# fewer than 128 Mamba blocks at startup, LOWER THIS to fit and record the
# figure - do not raise VLLM_GPU_UTIL past 0.92 to chase the old number.
VLLM_MAX_NUM_SEQS=128

# MANDATORY. Without it ~1400 tokens of chain-of-thought land in `content`,
# and Stage 2's JSON extractor grabs the schema echo out of the reasoning text.
VLLM_REASONING_PARSER=qwen3

# 0.90 ON THE REAL CARD, DELIBERATELY NOT 0.48.
#
# 0.48 was the SIMULATION cap: the whole 2026-08-25 evaluation ran on a 96 GB
# RTX PRO 6000 held down to 0.48 to imitate a 48 GB card. node-05 has a real
# RTX PRO 5000 Blackwell, 48935 MiB measured. Carrying 0.48 forward would have
# given the model 23 GB of a 48 GB card and then reported the result as a
# 48 GB measurement. Ceiling for this package is 0.92 (task 1(d)).
VLLM_GPU_UTIL=0.90

# Worker -> vLLM auth. The same shared internal key nodes 02/03/04 use
# (docker-compose.node02.yml `--api-key ${VLLM_API_KEY:-ivgs-internal}`); it
# gates the LAN port, it is not a credential to any external service, and it
# is the pattern node-04's env already follows. Rotate it on all four nodes at
# once or the workers stop being able to call any of them.
VLLM_API_KEY=ivgs-internal

# HuggingFace cache. A NODE-LOCAL path, never /mnt/ivgs-shared: the weights are
# ~29 GB, they are mmap'd at load, and mmap over NFS is the reason node-02's
# CogVideoX weights were staged to /opt/models (docker-compose.node02.yml:
# "local-staged weights (NOT /mnt NFS: mmap-over-NFS too slow)").
HF_HOME=/data/hf-cache

# === NFS Shared Volume =======================================================
# Mounted read-only into nothing today. Declared because the weights manifest
# (Task 1(b)) is written to it by the operator block, from the HOST, not from
# a container.
SHARED_VOLUME_PATH=/mnt/ivgs-shared

# === PROHIBITED ==============================================================
# OPENAI_API_KEY - NEVER
# ANTHROPIC_API_KEY - NEVER
# ELEVENLABS_API_KEY - NEVER
# DID_API_KEY - NEVER
