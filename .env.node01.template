# =============================================================================
# IVGS v5 — Environment Variables: node-01 (Infrastructure)
# =============================================================================
# Spec reference: Appendix A.2 — Environment Variable Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env.node01
#   2. Replace ALL 'CHANGE_ME' values with actual secrets
#   3. Set file permissions: chmod 600 .env.node01 && chown root:root .env.node01
#   4. NEVER commit .env.node01 to version control
#
# This file is root-owned with 600 permissions per §16.3
# =============================================================================

# === Docker Image Tags (pinned — no :latest per §19.5) ===
IVGS_API_TAG=CHANGE_ME_TO_SHA_DIGEST
IVGS_FRONTEND_TAG=CHANGE_ME_TO_SHA_DIGEST
IVGS_SCHEDULER_TAG=CHANGE_ME_TO_SHA_DIGEST
IVGS_WORKERS_TAG=CHANGE_ME_TO_SHA_DIGEST

# === Database (§2.4 — PostgreSQL 17 on node-01) ===
POSTGRES_DB=ivgs
POSTGRES_USER=ivgs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32_CHARS
DATABASE_URL=postgresql+psycopg://ivgs:CHANGE_ME_STRONG_PASSWORD_32_CHARS@postgres:5432/ivgs

# === Redis (§2.4 — Redis 7 on node-01) ===
REDIS_URL=redis://redis:6379/0

# === SeaweedFS (§2.4, Table 2-4) ===
SEAWEEDFS_MASTER_URL=http://seaweedfs-master:9333
SEAWEEDFS_FILER_URL=http://seaweedfs-filer:8888

# === GPU Scheduler (§12, Table 2-4: internal port 8001) ===
GPU_SCHEDULER_URL=http://ivgs-scheduler:8001

# === GPU / remote-node service URLs ===
# NOT defined here. An env_file cannot interpolate ${VARS}, so these URLs are
# composed in docker-compose.node01.yml (x-gpu-service-urls anchor) from
# SUBNET_PREFIX / NODE_xx_IP / *_PORT in .env and delivered via `environment:`.
# Do NOT add literal URLs here.

# === Authentication (§16.1 Table 16-1) ===
JWT_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET_64_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# === Backup (§14.1 Table 14-1) ===
BACKUP_NAS_PATH=/mnt/backup/ivgs
BACKUP_GPG_KEY_ID=CHANGE_ME_YOUR_GPG_KEY_ID
BACKUP_RETENTION_DB_DAYS=30
BACKUP_RETENTION_WAL_DAYS=7
BACKUP_RETENTION_ASSETS_DAYS=14
BACKUP_RETENTION_CONFIG_DAYS=90

# === NFS Shared Volume (§2.3) ===
SHARED_VOLUME_PATH=/mnt/ivgs-shared

# === Grafana (§13.2) ===
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# === GitHub Actions Runner ===
GITHUB_REPO_URL=https://github.com/brucecostello2/elearning
GITHUB_RUNNER_TOKEN=CHANGE_ME_RUNNER_TOKEN

# === Rate Limiting (§16.3) ===
RATE_LIMIT_CONTENT_CRUD=60/minute
RATE_LIMIT_JOB_TRIGGERS=10/minute
RATE_LIMIT_AUTH_LOGIN=5/minute

# === PROHIBITED — these MUST NOT appear in .env (Appendix A.2, §F.2) ===
# OPENAI_API_KEY — NEVER
# ANTHROPIC_API_KEY — NEVER
# ELEVENLABS_API_KEY — NEVER
# DID_API_KEY — NEVER
# SYNTHESIA_API_KEY — NEVER
